@bot.message_handler(func=lambda m: user_states.get(m.from_user.id) == "waiting_topup_amount")
def handle_topup_amount(message):
    try:
        amount = int(message.text.strip())
    except:
        return bot.reply_to(message, f"❌ Введите число от {MIN_TOPUP} до {MAX_TOPUP}")

    if amount < MIN_TOPUP or amount > MAX_TOPUP:
        return bot.reply_to(message, f"❌ Сумма должна быть от {MIN_TOPUP}₽ до {MAX_TOPUP}₽")

